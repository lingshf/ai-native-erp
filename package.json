{
  "name": "ai-native-erp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": "26.x"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "koffi": false
  },
  "dependencies": {
    "@github/copilot-sdk": "1.0.31"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.mjs",
    "start:local": "node packages/infra/src/main.ts",
    "ledger:read": "node scripts/read-legacy-ledger.mjs",
    "preview:legacy": "node scripts/preview-legacy-snapshot.mjs",
    "storage:admin": "node scripts/storage-admin.mjs",
    "test": "vitest run",
    "test:changed": "vitest run --changed origin/main",
    "test:legacy": "node --test tests/*.test.mjs",
    "build": "npm run build --workspace @erp/web",
    "openapi": "node packages/core/generate-openapi.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:workspaces": "vitest run",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "test:boundaries": "vitest run packages/infra/test/tooling/boundaries.test.ts",
    "verify": "npm run check && npm run typecheck && npm run check:boundaries && npm test && npm run test:legacy && npm run build",
    "verify:sqlite": "vitest run packages/infra/test/storage-sqlite.test.ts packages/infra/test/storage-admin-cli.test.ts",
    "check": "biome ci"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@babel/parser": "7.29.13",
    "@types/node": "26.6.6",
    "acorn": "8.19.0",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "@vitejs/plugin-react": "5.2.0",
    "vitest": "5.1.0"
  }
}
