{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"]
  },
  "include": [
    "vitest.config.ts",
    "scripts/ci.ts",
    "packages/infra/bench/**/*.ts",
    "packages/infra/test/tooling/ci.test.ts",
    "packages/core/src/**/*.ts",
    "packages/core/test-types/**/*.ts",
    "packages/infra/src/**/*.ts",
    "packages/web/src/**/*.ts",
    "packages/web/src/**/*.tsx",
    "packages/web/test/**/*.ts",
    "packages/web/test/**/*.tsx",
    "packages/web/*.config.ts"
  ]
}
