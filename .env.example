# Export these settings in the start:local process; it does not load .env automatically.
# Never commit credentials or paste them into the UI.
ERP_PROFILE=local
ERP_HOST=127.0.0.1
ERP_PORT=4180
# ERP_SQLITE_FILE=C:\AccountingLabData\new-target.sqlite
AI_PROVIDER=copilot
# Set an explicit model available to your supported Copilot authentication.
AI_MODEL=
AI_TIMEOUT_MS=30000
