# Copy to .env locally. Never commit credentials or paste them into the UI.
AI_PROVIDER=openai
# For existing supported Copilot environment authentication instead:
# AI_PROVIDER=copilot
# AI_MODEL=gpt-6.1-sol
# Copilot ignores AI_BASE_URL and AI_API_KEY; no endpoint/key copying.
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
AI_API_KEY=
PORT=4173
# Optional absolute path for local SQLite storage; default is .\data
# DATA_DIR=C:\AccountingLabData
